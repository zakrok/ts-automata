{
    "name": "ts-automata",
    "version": "1.0.2",
    "description": "Automata utility package for FSMs, PDAs, TMs in JS/TS.",
    "keywords": [
        "automata",
        "typescript",
        "math",
        "finite-state-machine",
        "pushdown-automaton",
        "turing-machine",
        "dfa",
        "nfa",
        "pda",
        "tm"
    ],
    "license": "MIT",
    "author": {
        "name": "Kiril Panayotov",
        "email": "contact@zakrok.dev",
        "url": "https://zakrok.dev"
    },
    "contributors": [
        {
            "name": "San Demiroren",
            "email": "Sandemiroren1@gmail.com",
            "url": "https://github.com/sandemiroren1"
        }
    ],
    "homepage": "https://github.com/Zakrok09/ts-automata",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "main": "./dist/index.js",
    "module": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "type": "module",
    "files": [
        "dist",
        "package.json",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc && vite build",
        "build:watch": "tsc && vite build --watch",
        "test": "vitest",
        "coverage": "vitest run --coverage",
        "prettier": "node --experimental-strip-types node_modules/prettier/bin/prettier.cjs . --write"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@fast-check/vitest": "^0.4.1",
        "@types/node": "^25.9.1",
        "@vitest/coverage-v8": "^4.1.7",
        "eslint": "^10.4.0",
        "jiti": "^2.7.0",
        "prettier": "3.8.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.0",
        "vite": "^8.0.14",
        "vite-plugin-dts": "^5.0.1",
        "vitest": "^4.1.7"
    }
}
